{
  "name": "peoplepay360",
  "version": "1.0.0",
  "description": "PEOPLEPAY360 - Enterprise Connected HR & Payroll Management Platform",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "start": "npm run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "seed": "node server/database/seeders.js",
    "test": "npm --prefix server test"
  },
  "keywords": [
    "payroll",
    "hr",
    "human-resources",
    "payroll-engine",
    "enterprise-software",
    "attendance",
    "contracts",
    "payslip"
  ],
  "author": "PeoplePay360 Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "nodemailer": "^10.0.0"
  }
}
