# PeoplePay360 Environment Configuration Example
# ================================================
# Copy this file to .env and fill in your values.

# Server
NODE_ENV=development
PORT=5000

# Database — MySQL
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=peoplepay360
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# App
APP_NAME=PeoplePay360
APP_URL=http://localhost:5000

# Email SMTP (optional — payslip dispatch)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@peoplepay360.com
